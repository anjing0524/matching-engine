[Unit]
Description=Exchange middleware sequencing and market-data process
After=network.target
Before=exchange-core.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=exchange
Group=exchange
EnvironmentFile=/etc/exchange/middleware.env
ExecStart=/opt/exchange/bin/exchange-middleware
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/exchange /var/lib/exchange
KillSignal=SIGTERM
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
