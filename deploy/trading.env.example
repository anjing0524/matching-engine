# Core
TRADING_CORE_COMMAND_RING=/run/trading/command.ring
TRADING_CORE_PUBLIC_RING=/run/trading/public.ring
TRADING_CORE_PRIVATE_RING=/run/trading/private.ring
TRADING_CORE_INSTRUMENT=BTCUSDT
TRADING_CORE_SNAPSHOT=/var/lib/trading/core.snapshot.json
# Single-file log:
TRADING_COMMAND_LOG=/var/lib/trading/commands.log
# Or rotating directory:
TRADING_COMMAND_LOG_DIR=/var/lib/trading/commands
TRADING_PUBLIC_RESULT_LOG=/var/lib/trading/public.log
TRADING_PRIVATE_RESULT_LOG=/var/lib/trading/private.log
# Or rotating directories:
TRADING_PUBLIC_RESULT_LOG_DIR=/var/lib/trading/public
TRADING_PRIVATE_RESULT_LOG_DIR=/var/lib/trading/private

# Middleware
TRADING_MIDDLEWARE_LISTEN=0.0.0.0:7000
TRADING_MULTICAST_GROUP=239.10.20.30
TRADING_MULTICAST_PORT=40000
TRADING_MULTICAST_INTERFACE=192.168.10.20
TRADING_REPAIR_BUFFER=1000000
TRADING_PRIVATE_REPLAY=4096

# Gateway
TRADING_GATEWAY_LISTEN=0.0.0.0:8000
TRADING_GATEWAY_IDLE_TIMEOUT=15
TRADING_AUTH_TOKEN=change-me-u64
TRADING_REDIRECT_TARGET=gateway-b.example:8000
TRADING_REDIRECT_ENDPOINTS=gateway-a.example:8000,gateway-b.example:8000
TRADING_METRICS_LISTEN=127.0.0.1:9100
