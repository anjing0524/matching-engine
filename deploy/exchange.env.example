# Core
EXCHANGE_CORE_COMMAND_RING=/run/exchange/command.ring
EXCHANGE_CORE_PUBLIC_RING=/run/exchange/public.ring
EXCHANGE_CORE_PRIVATE_RING=/run/exchange/private.ring
EXCHANGE_CORE_INSTRUMENT=BTCUSDT
EXCHANGE_CORE_SNAPSHOT=/var/lib/exchange/core.snapshot.json
# Single-file log:
EXCHANGE_COMMAND_LOG=/var/lib/exchange/commands.log
# Or rotating directory:
EXCHANGE_COMMAND_LOG_DIR=/var/lib/exchange/commands

# Middleware
EXCHANGE_MIDDLEWARE_LISTEN=0.0.0.0:7000
EXCHANGE_MULTICAST_GROUP=239.10.20.30
EXCHANGE_MULTICAST_PORT=40000
EXCHANGE_MULTICAST_INTERFACE=192.168.10.20
EXCHANGE_REPAIR_BUFFER=1000000
EXCHANGE_PRIVATE_REPLAY=4096

# Gateway
EXCHANGE_GATEWAY_LISTEN=0.0.0.0:8000
EXCHANGE_GATEWAY_IDLE_TIMEOUT=15
EXCHANGE_AUTH_TOKEN=change-me-u64
EXCHANGE_METRICS_LISTEN=127.0.0.1:9100
