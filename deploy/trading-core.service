[Unit]
Description=Trading core matching process
After=network.target
Wants=trading-middleware.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=trading
Group=trading
EnvironmentFile=/etc/trading/core.env
ExecStart=/opt/trading/bin/trading-core
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576
LimitMEMLOCK=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/trading /var/lib/trading
KillSignal=SIGTERM
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
